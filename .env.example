# Keep the ComfyUI server private. Do not expose it directly to the public internet.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CLIENT_ID=keem-render-local
# Optional bearer/API key if your ComfyUI deployment is protected.
COMFYUI_API_KEY=

# IDs in the API-format workflow JSON. Match these to your own workflow.
COMFYUI_LOAD_IMAGE_NODE=2
COMFYUI_POSITIVE_PROMPT_NODE=3
COMFYUI_NEGATIVE_PROMPT_NODE=4
COMFYUI_SAMPLER_NODE=5
COMFYUI_SAVE_IMAGE_NODE=8
COMFYUI_IMAGE_SCALE_NODE=9
COMFYUI_WORKFLOW_PATH=./workflows/sdxl-img2img-api.json